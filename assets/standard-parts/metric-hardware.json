    {
      "id": "fuller-washer",
      "title": "Fuller Fasteners DIN 125 normal-series washer dimensions",
      "url": "https://fullerfasteners.com/tech/din-125-specifications-flat-washer-normal-series/",
      "retrieved": "2026-10-12",
      "notes": "Selected nominal inner diameter, maximum/nominal outside diameter and nominal thickness, Form A without chamfer. No stock availability or material class is inferred."
    },
    {
      "id": "ad-nut",
      "title": "A&D Fasteners full nut metric dimensions",
      "url": "https://www.aanddfasteners.co.uk/uploads/media/CVwuYn-media-DIN934Fullnutspecification.pdf",
      "retrieved": "2026-10-12",
      "notes": "Selected DIN 934 width across flats and height; the supplier heading also names ISO 4032 but the dimensional rows differ from current ISO dimensions. TCAD labels these rows DIN 934 only. Straight hexagon and nominal-diameter smooth bore omit threads and face chamfers."
    },
    {
      "id": "fuller-socket",
      "title": "Fuller Fasteners ISO 4762 socket cap screw dimensions",
      "url": "https://fullerfasteners.com/tech/iso-4762-12474-specifications-hex-socket-cap-screws/",
      "retrieved": "2026-10-12",
      "notes": "Selected plain-head maximum diameter, maximum height, nominal hex key size and minimum socket depth; flat-ended socket, unthreaded nominal-diameter envelope and square edges are explicit modeling simplifications."
    },
    {
      "id": "fuller-hex",
      "title": "Fuller Fasteners DIN 933 hex head screw dimensions",
      "url": "https://fullerfasteners.com/tech/din-933-specifications-hex-head-screws-fully-threaded/",
      "retrieved": "2026-10-12",
      "notes": "Selected nominal head height, maximum/nominal width across flats, nominal diameter and coarse pitch. DIN pattern retained (M10=17 mm and M12=19 mm flats); no ISO equivalence or certification is claimed. Square head edges and unthreaded shank omit runout, end chamfer, collar and fillets."
    }
  ],

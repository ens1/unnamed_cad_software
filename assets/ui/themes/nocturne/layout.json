{
  "schema_version": 1,
  "components": {
    "context": {
      "role": "document-context",
      "bind": "workspace.context"
    },
    "navigation": {
      "role": "view-navigation",
      "bind": "workspace.navigation"
    },
    "dependencies": {
      "role": "dependency-view",
      "bind": "workspace.dependencies"
    },
    "parameters": {
      "role": "property-manager",
      "bind": "workspace.active_operation.parameters"
    },
    "preview": {
      "role": "preview-status",
      "bind": "workspace.draft.status"
    },
    "apply": {
      "role": "apply-action",
      "command": "draft.apply"
    },
    "cancel": {
      "role": "cancel-action",
      "command": "draft.cancel"
    },
    "viewport": {
      "role": "model-viewport",
      "bind": "workspace.viewport"
    },
    "commands": {
      "role": "command-manager"
    },
    "status": {
      "role": "status-bar"
    }
  },
  "layouts": {
    "nocturne-workspace": {
      "id": "nocturne",
      "role": "workspace",
      "classes": [
        "nocturne-workspace"
      ],
      "layout": "column",
      "gap_logical_px": 10,
      "padding_logical_px": [
        8,
        10,
        8,
        10
      ],
      "children": [
        {
          "id": "nocturne-context",
          "use": "context",
          "height_logical_px": 42
        },
        {
          "id": "nocturne-model-row",
          "layout": "row",
          "grow": 1,
          "gap_logical_px": 10,
          "children": [
            {
              "id": "nocturne-quick-actions",
              "role": "quick-action-rail",
              "classes": [
                "nocturne-quick-rail"
              ],
              "layout": "column",
              "width_logical_px": 78,
              "overflow": "auto",
              "gap_logical_px": 8,
              "padding_logical_px": [
                8,
                8,
                8,
                8
              ],
              "children": [
                {
                  "id": "nocturne-quick-settings",
                  "role": "quick-action",
                  "bind": "command:settings",
                  "widget": "action",
                  "label": "Settings",
                  "classes": [
                    "round-action"
                  ],
                  "height_logical_px": 62
                },
                {
                  "id": "nocturne-quick-commands",
                  "role": "quick-action",
                  "bind": "command:commands",
                  "widget": "action",
                  "label": "Find",
                  "classes": [
                    "round-action"
                  ],
                  "height_logical_px": 62
                },
                {
                  "id": "nocturne-quick-viewport.fit",
                  "role": "quick-action",
                  "bind": "command:viewport.fit",
                  "widget": "action",
                  "label": "Fit",
                  "classes": [
                    "round-action"
                  ],
                  "height_logical_px": 62
                },
                {
                  "id": "nocturne-quick-document.undo",
                  "role": "quick-action",
                  "bind": "command:document.undo",
                  "widget": "action",
                  "label": "Undo",
                  "classes": [
                    "square-action"
                  ],
                  "height_logical_px": 56
                },
                {
                  "id": "nocturne-quick-document.redo",
                  "role": "quick-action",
                  "bind": "command:document.redo",
                  "widget": "action",
                  "label": "Redo",
                  "classes": [
                    "square-action"
                  ],
                  "height_logical_px": 56
                },
                {
                  "id": "nocturne-zoom-actions",
                  "role": "semantic-command-collection",
                  "classes": [
                    "nocturne-zoom-collection"
                  ],
                  "layout": "column",
                  "height_logical_px": 132,
                  "gap_logical_px": 8,
                  "repeat": {
                    "role": "command",
                    "ids": [
                      "command:navigation.zoom-in",
                      "command:navigation.zoom-out"
                    ]
                  },
                  "template": {
                    "role": "quick-action",
                    "widget": "action",
                    "label": "{label}",
                    "classes": [
                      "round-action"
                    ],
                    "height_logical_px": 62
                  }
                }
              ]
            },
            {
              "id": "nocturne-viewport",
              "use": "viewport",
              "grow": 1
            },
            {
              "id": "nocturne-right-dock",
              "role": "instrument-rail",
              "classes": [
                "nocturne-inspector"
              ],
              "layout": "column",
              "width_logical_px": 292,
              "min_width_logical_px": 232,
              "max_width_logical_px": 560,
              "resizable": true,
              "children": [
                {
                  "id": "nocturne-navigation",
                  "use": "navigation",
                  "height_logical_px": 40
                },
                {
                  "id": "nocturne-model-tree",
                  "use": "dependencies",
                  "grow": 1,
                  "editing": {
                    "height_logical_px": 154,
                    "grow": 0
                  }
                },
                {
                  "id": "nocturne-property-manager",
                  "use": "parameters",
                  "height_logical_px": 0,
                  "grow": 0,
                  "editing": {
                    "height_logical_px": 0,
                    "grow": 1
                  }
                },
                {
                  "id": "nocturne-preview",
                  "use": "preview",
                  "height_logical_px": 54
                },
                {
                  "id": "nocturne-confirmation",
                  "role": "confirmation-group",
                  "layout": "row",
                  "height_logical_px": 80,
                  "gap_logical_px": 12,
                  "padding_logical_px": [
                    8,
                    10,
                    8,
                    10
                  ],
                  "children": [
                    {
                      "id": "nocturne-apply",
                      "use": "apply",
                      "width_logical_px": 62
                    },
                    {
                      "id": "nocturne-cancel",
                      "use": "cancel",
                      "grow": 1
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "nocturne-command-dock",
          "use": "commands",
          "height_logical_px": 112,
          "classes": [
            "nocturne-command-dock"
          ]
        },
        {
          "id": "nocturne-status",
          "use": "status",
          "height_logical_px": 30
        }
      ]
    },

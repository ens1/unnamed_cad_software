{
  "schema_version": 1,
  "variables": {
    "--panel": "#F4F1E9",
    "--ink": "#191919",
    "--active": "#FF5A00",
    "--valid": "#2DAA45",
    "--spacing": "4px",
    "--reference": "#0087BE",
    "--font-size": "11px",
    "--control-height": "24px",
    "--target-size": "24px",
    "--warning": "#B37400",
    "--error": "#AD392B",
    "--workspace": "#D5D9DF"
  },
  "rules": [
    {
      "selector": "[role=selection-actions]",
      "properties": {
        "background": "var(--panel)",
        "padding": "8px",
        "border": "1px solid #A9ACAF",
        "border-radius": "6px"
      }
    },
    {
      "selector": "*",
      "properties": {
        "color": "var(--ink)",
        "gap": "var(--spacing)",
        "font-size": "var(--font-size)"
      }
    },
    {
      "selector": "[role=instrument-rail], [role=workspace-toolbar], [role=editor-group]",
      "properties": {
        "background": "var(--panel)",
        "padding": "0px"
      }
    },
    {
      "selector": "[role=property-manager], [role=parameter-instrument]",
      "properties": {
        "font-size": "var(--font-size)",
        "font-variant-numeric": "tabular-nums"
      }
    },
    {
      "selector": "[role=apply-action]",
      "properties": {
        "background": "var(--active)",
        "border": "2px solid var(--ink)"
      }
    },
    {
      "selector": "[layout=instrument-rail] [role=apply-action]",
      "properties": {
        "border-radius": "50%",
        "width": "44px",
        "height": "44px",
        "font-size": "11px"
      }
    },
    {
      "selector": "[layout=top-workspace] [role=apply-action]",
      "properties": {
        "border-radius": "4px",
        "padding": "12px 24px"
      }
    },
    {
      "selector": "[role=preview-status][state=valid]",
      "properties": {
        "color": "var(--valid)"
      }
    },
    {
      "selector": "[role=document-context], [role=command-manager], [role=status-bar]",
      "properties": {
        "background": "#F2F0EB",
        "padding": "5px",
        "border": "1px solid #C2C5CA"
      }
    },
    {
      "selector": "[role=model-viewport]",
      "properties": {
        "background": "#D5D9DF",
        "selection-color": "#FF5A00",
        "preview-color": "#FFAD4266",
        "preview-added-color": "#4ECF8880",
        "preview-removed-color": "#FF8A4A80",
        "preview-edge-width": "1.25px"
      }
    },
    {
      "selector": "[role=dependency-view], [role=view-navigation], [role=property-manager]",
      "properties": {
        "background": "var(--panel)",
        "padding": "6px"
      }
    },
    {
      "selector": ".semantic-control, .toolbar-control, [role=command-action], [role=command-tab], [role=view-control]",
      "properties": {
        "min-target-size": "var(--target-size)",
        "height": "var(--control-height)",
        "padding": "3px 6px",
        "border-radius": "3px"
      }
    },
    {
      "selector": ".toolbar-control",
      "properties": {
        "height": "26px",
        "padding": "3px 5px",
        "font-size": "10.5px",
        "icon-size": "18px",
        "border": "none",
        "background": "#F4F1E9"
      }
    },
    {
      "selector": ".toolbar-control:hover, [role=menu-action]:hover, [role=selection-action]:hover",
      "properties": {
        "background": "#E4E0D8"
      }
    },
    {
      "selector": "[role=command-tab][state=selected], .toolbar-control[state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2",
        "border": "1px solid #FF5A00"
      }
    },
    {
      "selector": "[role=menu-action], [role=selection-action]",
      "properties": {
        "width": "100%",
        "height": "24px",
        "padding": "3px 6px",
        "border": "none"
      }
    },
    {
      "selector": "[role=apply-action]",
      "properties": {
        "background": "var(--active)",
        "color": "var(--ink)",
        "width": "44px",
        "height": "44px",
        "border-radius": "50%",
        "border": "1px solid var(--ink)"
      }
    },
    {
      "selector": "[role=apply-action][state=disabled]",
      "properties": {
        "background": "#D9D5CE",
        "color": "#77736E"
      }
    },
    {
      "selector": "[role=cancel-action]",
      "properties": {
        "color": "var(--ink)",
        "background": "#F4F1E9",
        "padding": "3px 8px",
        "border": "none",
        "height": "26px"
      }
    },
    {
      "selector": "[role=viewport-toolbar]",
      "properties": {
        "font-size": "11px",
        "padding": "0px"
      }
    },
    {
      "selector": "[role=navigation-hint]",
      "properties": {
        "font-size": "10px",
        "color": "#666666"
      }
    },
    {
      "selector": "[role=semantic-command-collection], [role=semantic-feature-collection], [role=semantic-field-collection]",
      "properties": {
        "background": "var(--panel)",
        "padding": "4px",
        "gap": "2px",
        "overflow": "auto"
      }
    },
    {
      "selector": "[role=semantic-feature-item]",
      "properties": {
        "padding": "2px",
        "height": "28px"
      }
    },
    {
      "selector": "[role=semantic-field-item]",
      "properties": {
        "padding": "4px",
        "height": "58px"
      }
    },
    {
      "selector": ".feature-tree-row, [role=history-station]",
      "properties": {
        "width": "100%",
        "text-align": "left",
        "padding": "2px 4px",
        "border": "none",
        "background": "transparent",
        "height": "24px",
        "icon-size": "8px",
        "text-overflow": "ellipsis"
      }
    },
    {
      "selector": ".feature-tree-row[state=selected], [role=history-station][state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2",
        "height": "24px"
      }
    },
    {
      "selector": "[role=history-path]",
      "properties": {
        "color": "#666666",
        "stroke-width": "1px"
      }
    },
    {
      "selector": "[role=view-cube]",
      "properties": {
        "font-size": "9px"
      }
    },
    {
      "selector": "[role=settings-dialog]",
      "properties": {
        "background": "var(--panel)",
        "padding": "10px",
        "border": "1px solid #A9ACAF",
        "border-radius": "6px",
        "gap": "6px"
      }
    },
    {
      "selector": "[role=settings-title]",
      "properties": {
        "font-size": "14px",
        "font-weight": "bold"
      }
    },
    {
      "selector": "[role=settings-scope], [role=settings-heading]",
      "properties": {
        "font-weight": "bold",
        "font-size": "11px"
      }
    },
    {
      "selector": "[role=settings-category]",
      "properties": {
        "height": "24px",
        "padding": "3px 6px",
        "border-radius": "3px"
      }
    },
    {
      "selector": "[role=settings-category][state=selected], [role=settings-action].primary",
      "properties": {
        "background": "var(--active)",
        "color": "#191919"
      }
    },
    {
      "selector": "[role=settings-description]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=settings-diagnostic][state=invalid]",
      "properties": {
        "color": "var(--error)"
      }
    },
    {
      "selector": "[role=appearance-panel]",
      "properties": {
        "display": "none",
        "background": "var(--panel)",
        "padding": "6px",
        "border": "1px solid #C2C5CA",
        "gap": "4px",
        "font-size": "11px"
      }
    },
    {
      "selector": "[role=appearance-panel][state=open]",
      "properties": {
        "display": "block"
      }
    },
    {
      "selector": "[role=appearance-panel][state=closed]",
      "properties": {
        "display": "none"
      }
    },
    {
      "selector": "[role=appearance-heading]",
      "properties": {
        "font-size": "12px",
        "font-weight": "bold"
      }
    },
    {
      "selector": "[role=appearance-description]",
      "properties": {
        "font-size": "10px",
        "color": "#666666"
      }
    },
    {
      "selector": "[role=appearance-panel] .semantic-control, [role=appearance-action], [role=appearance-tab], [role=appearance-target]",
      "properties": {
        "height": "24px",
        "min-target-size": "24px",
        "padding": "3px 6px",
        "border-radius": "3px",
        "font-size": "11px"
      }
    },
    {
      "selector": "[role=appearance-action], [role=appearance-tab], [role=appearance-target]",
      "properties": {
        "background": "#F4F1E9",
        "border": "1px solid #C2C5CA"
      }
    },
    {
      "selector": "[role=appearance-action]:hover, [role=appearance-tab]:hover, [role=appearance-target]:hover",
      "properties": {
        "background": "#E4E0D8"
      }
    },
    {
      "selector": "[role=appearance-tab][state=selected], [role=appearance-target][state=selected]",
      "properties": {
        "background": "#FFE3D2",
        "color": "var(--active)",
        "border": "1px solid var(--active)"
      }
    },
    {
      "selector": "[role=appearance-field], [role=appearance-library-selection], [role=appearance-source]",
      "properties": {
        "font-size": "11px",
        "gap": "4px",
        "padding": "3px 4px",
        "border-radius": "3px",
        "min-target-size": "24px"
      }
    },
    {
      "selector": "[role=appearance-texture-row]",
      "properties": {
        "background": "#ECE9E2",
        "padding": "5px",
        "border": "1px solid #C2C5CA",
        "border-radius": "3px",
        "gap": "4px"
      }
    },
    {
      "selector": "[role=appearance-swatch]",
      "properties": {
        "height": "24px",
        "width": "24px",
        "border": "1px solid #A9ACAF",
        "border-radius": "3px"
      }
    },
    {
      "selector": "[role=workspace-action], [role=sketch-feedback-filter], [role=sketch-annotation-toggle], [role=sketch-dimension-mode], [role=edge-selection-action], [role=reference-repair-action]",
      "properties": {
        "height": "var(--control-height)",
        "min-height": "var(--target-size)",
        "padding": "2px 5px",
        "border-radius": "3px"
      }
    },
    {
      "selector": "[role=workspace-action][state=selected], [role=sketch-feedback-filter][state=selected], [role=sketch-annotation-toggle][state=selected], [role=sketch-dimension-mode][state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2"
      }
    },
    {
      "selector": "[role=sketch-constraint], [role=edge-selection-item], [role=reference-repair-input], [role=reference-repair-failure]",
      "properties": {
        "height": "var(--control-height)",
        "text-align": "left",
        "padding": "2px 4px",
        "border-radius": "2px"
      }
    },
    {
      "selector": "[role=sketch-constraint][state=selected], [role=edge-selection-item][state=selected], [role=reference-repair-input][state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2"
      }
    },
    {
      "selector": "[role=sketch-constraint][state=unsatisfied], [role=reference-repair-failure][state=invalid]",
      "properties": {
        "color": "var(--error)"
      }
    },
    {
      "selector": "[role=model-context-label], [role=workspace-heading]",
      "properties": {
        "font-size": "12px"
      }
    },
    {
      "selector": "[role=selection-summary], [role=selection-candidate-summary], [role=navigation-instructions], [role=workspace-description], [role=sketch-feedback-summary], [role=reference-repair-summary]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=sketch-constraint-delete]",
      "properties": {
        "width": "24px",
        "height": "24px",
        "padding": "2px"
      }
    },
    {
      "selector": "[role=viewport-toolbar]",
      "properties": {
        "height": "28px"
      }
    },
    {
      "selector": "[role=viewport-toolbar][state=selected], [role=viewport-toolbar][state=editing], [role=viewport-toolbar][state=inspection]",
      "properties": {
        "height": "56px"
      }
    },
    {
      "selector": "[role=validation-summary]",
      "properties": {
        "font-weight": "bold",
        "font-size": "11px"
      }
    },
    {
      "selector": "[role=status-message]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=validation-summary][state=invalid], [role=status-message][state=invalid], [role=repair-message][state=error]",
      "properties": {
        "color": "var(--error)"
      }
    },
    {
      "selector": "[role=validation-summary][state=pending], [role=repair-message][state=warning]",
      "properties": {
        "color": "var(--warning)"
      }
    },
    {
      "selector": "[role=repair-action], [role=repair-input], [role=repair-feature-choice], [role=repair-candidate-choice]",
      "properties": {
        "height": "var(--control-height)",
        "padding": "2px 4px"
      }
    },
    {
      "selector": "[role=repair-input][state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2"
      }
    },
    {
      "selector": "[role=repair-summary], [role=repair-message]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=sketch-constraint]",
      "properties": {
        "width": "100%",
        "text-align": "left",
        "text-overflow": "ellipsis"
      }
    },
    {
      "selector": "[role=repair-input], [role=repair-feature-choice], [role=repair-candidate-choice], [role=repair-history-choice], [role=repair-element-choice]",
      "properties": {
        "max-width": "100%",
        "text-align": "left",
        "text-overflow": "ellipsis"
      }
    },
    {
      "selector": "[role=sketch-solve-summary]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=sketch-feedback-error][state=invalid], [role=sketch-solve-summary][state=invalid]",
      "properties": {
        "color": "var(--error)"
      }
    },
    {
      "selector": "[role=feature-drop-marker]",
      "properties": {
        "color": "var(--active)",
        "stroke-width": "2px"
      }
    },
    {
      "selector": "[role=feature-drop-marker][state=disabled]",
      "properties": {
        "color": "var(--error)"
      }
    },
    {
      "selector": "[role=feature-drop-hint], [role=operation-editor-help], [role=sketch-motion-note]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=feature-reorder-target], [role=operation-editor-action], [role=sketch-repair-action], [role=assembly-motion-action]",
      "properties": {
        "height": "22px",
        "min-target-size": "24px",
        "padding": "2px 4px",
        "border-radius": "3px"
      }
    },
    {
      "selector": "[role=operation-editor-group]",
      "properties": {
        "font-size": "10px",
        "padding": "3px 0px",
        "gap": "3px"
      }
    },
    {
      "selector": "[role=operation-editor-field], [role=assembly-motion-field], [role=assembly-motion-mode]",
      "properties": {
        "font-size": "11px",
        "gap": "2px",
        "padding": "2px"
      }
    },
    {
      "selector": "[role=sketch-point-motion]",
      "properties": {
        "color": "var(--reference)",
        "size": "24px",
        "stroke-width": "1.25px"
      }
    },
    {
      "selector": "[role=sketch-point-motion][state=constrained]",
      "properties": {
        "color": "var(--valid)",
        "size": "4px"
      }
    },
    {
      "selector": "[role=sketch-constraint][state=dependent]",
      "properties": {
        "color": "var(--warning)"
      }
    },
    {
      "selector": "[role=field-unit]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=field-diagnostic][state=error]",
      "properties": {
        "color": "var(--error)",
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=operation-editor-field], [role=drawing-editor-field], [role=configuration-placement-field]",
      "properties": {
        "display": "flex",
        "flex-direction": "row",
        "gap": "3px",
        "padding": "1px 0px"
      }
    },
    {
      "selector": "[role=field-label].modeling-field, [role=field-label].drawing-field",
      "properties": {
        "width": "100px",
        "text-overflow": "ellipsis"
      }
    },
    {
      "selector": "[role=drawing-editor-group], [role=drawing-editor-help]",
      "properties": {
        "font-size": "10px",
        "padding": "3px 0px",
        "gap": "3px"
      }
    },
    {
      "selector": "[role=drawing-editor-action]",
      "properties": {
        "height": "22px",
        "min-target-size": "24px",
        "padding": "2px 4px",
        "border-radius": "3px"
      }
    },
    {
      "selector": "[role=assembly-motion-handle]",
      "properties": {
        "width": "84px",
        "handle-size": "8px",
        "stroke-width": "2px",
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=assembly-motion-handle].axis-x",
      "properties": {
        "color": "#D95543"
      }
    },
    {
      "selector": "[role=assembly-motion-handle].axis-y",
      "properties": {
        "color": "#369159"
      }
    },
    {
      "selector": "[role=assembly-motion-handle].axis-z",
      "properties": {
        "color": "#287ACC"
      }
    },
    {
      "selector": "[role=assembly-motion-handle][state=dragging], [role=assembly-motion-handle][state=selected]",
      "properties": {
        "color": "var(--active)",
        "stroke-width": "3px"
      }
    },
    {
      "selector": "[role=assembly-motion-request]",
      "properties": {
        "color": "var(--warning)",
        "handle-size": "7px",
        "stroke-width": "1.5px"
      }
    },
    {
      "selector": "[role=configuration-placement-field][state=inherited]",
      "properties": {
        "color": "var(--reference)"
      }
    },
    {
      "selector": "[role=configuration-placement-field][state=expression-driven]",
      "properties": {
        "color": "var(--warning)"
      }
    },
    {
      "selector": "[role=configuration-placement-field][state=invalid], [role=drawing-editor-field][state=error], [role=operation-editor-field][state=error]",
      "properties": {
        "color": "var(--error)"
      }
    },
    {
      "selector": "[role=field-choices]",
      "properties": {
        "max-height": "240px"
      }
    },
    {
      "selector": "[role=configuration-placement-field]",
      "properties": {
        "flex-direction": "column"
      }
    },
    {
      "selector": "[role=drawing-annotation-field]",
      "properties": {
        "display": "flex",
        "flex-direction": "row",
        "gap": "3px",
        "padding": "1px 0px"
      }
    }
  ]
}

{
  "schema_version": 1,
  "variables": {
    "--panel": "#F4F1E9",
    "--ink": "#191919",
    "--active": "#FF5A00",
    "--valid": "#2DAA45",
    "--spacing": "4px",
    "--reference": "#0087BE",
    "--font-size": "11px",
    "--control-height": "24px",
    "--target-size": "24px",
    "--warning": "#B37400",
    "--error": "#AD392B",
    "--workspace": "#D5D9DF"
  },
  "rules": [
    {
      "selector": "[role=selection-actions]",
      "properties": {
        "background": "var(--panel)",
        "padding": "8px",
        "border": "1px solid #A9ACAF",
        "border-radius": "6px"
      }
    },
    {
      "selector": "*",
      "properties": {
        "color": "var(--ink)",
        "gap": "var(--spacing)",
        "font-size": "var(--font-size)"
      }
    },
    {
      "selector": "[role=instrument-rail], [role=workspace-toolbar], [role=editor-group]",
      "properties": {
        "background": "var(--panel)",
        "padding": "0px"
      }
    },
    {
      "selector": "[role=property-manager], [role=parameter-instrument]",
      "properties": {
        "font-size": "var(--font-size)",
        "font-variant-numeric": "tabular-nums"
      }
    },
    {
      "selector": "[role=apply-action]",
      "properties": {
        "background": "var(--active)",
        "border": "2px solid var(--ink)"
      }
    },
    {
      "selector": "[layout=instrument-rail] [role=apply-action]",
      "properties": {
        "border-radius": "50%",
        "width": "44px",
        "height": "44px",
        "font-size": "11px"
      }
    },
    {
      "selector": "[layout=top-workspace] [role=apply-action]",
      "properties": {
        "border-radius": "4px",
        "padding": "12px 24px"
      }
    },
    {
      "selector": "[role=preview-status][state=valid]",
      "properties": {
        "color": "var(--valid)"
      }
    },
    {
      "selector": "[role=document-context], [role=command-manager], [role=status-bar]",
      "properties": {
        "background": "#F2F0EB",
        "padding": "5px",
        "border": "1px solid #C2C5CA"
      }
    },
    {
      "selector": "[role=model-viewport]",
      "properties": {
        "background": "#D5D9DF",
        "selection-color": "#FF5A00",
        "preview-color": "#FFAD4266",
        "preview-added-color": "#4ECF8880",
        "preview-removed-color": "#FF8A4A80",
        "preview-edge-width": "1.25px"
      }
    },
    {
      "selector": "[role=dependency-view], [role=view-navigation], [role=property-manager]",
      "properties": {
        "background": "var(--panel)",
        "padding": "6px"
      }
    },
    {
      "selector": ".semantic-control, .toolbar-control, [role=command-action], [role=command-tab], [role=view-control]",
      "properties": {
        "min-target-size": "var(--target-size)",
        "height": "var(--control-height)",
        "padding": "3px 6px",
        "border-radius": "3px"
      }
    },
    {
      "selector": ".toolbar-control",
      "properties": {
        "height": "26px",
        "padding": "3px 5px",
        "font-size": "10.5px",
        "icon-size": "18px",
        "border": "none",
        "background": "#F4F1E9"
      }
    },
    {
      "selector": ".toolbar-control:hover, [role=menu-action]:hover, [role=selection-action]:hover",
      "properties": {
        "background": "#E4E0D8"
      }
    },
    {
      "selector": "[role=command-tab][state=selected], .toolbar-control[state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2",
        "border": "1px solid #FF5A00"
      }
    },
    {
      "selector": "[role=menu-action], [role=selection-action]",
      "properties": {
        "width": "100%",
        "height": "24px",
        "padding": "3px 6px",
        "border": "none"
      }
    },
    {
      "selector": "[role=apply-action]",
      "properties": {
        "background": "var(--active)",
        "color": "var(--ink)",
        "width": "44px",
        "height": "44px",
        "border-radius": "50%",
        "border": "1px solid var(--ink)"
      }
    },
    {
      "selector": "[role=apply-action][state=disabled]",
      "properties": {
        "background": "#D9D5CE",
        "color": "#77736E"
      }
    },
    {
      "selector": "[role=cancel-action]",
      "properties": {
        "color": "var(--ink)",
        "background": "#F4F1E9",
        "padding": "3px 8px",
        "border": "none",
        "height": "26px"
      }
    },
    {
      "selector": "[role=viewport-toolbar]",
      "properties": {
        "font-size": "11px",
        "padding": "0px"
      }
    },
    {
      "selector": "[role=navigation-hint]",
      "properties": {
        "font-size": "10px",
        "color": "#666666"
      }
    },
    {
      "selector": "[role=semantic-command-collection], [role=semantic-feature-collection], [role=semantic-field-collection]",
      "properties": {
        "background": "var(--panel)",
        "padding": "4px",
        "gap": "2px",
        "overflow": "auto"
      }
    },
    {
      "selector": "[role=semantic-feature-item]",
      "properties": {
        "padding": "2px",
        "height": "28px"
      }
    },
    {
      "selector": "[role=semantic-field-item]",
      "properties": {
        "padding": "4px",
        "height": "58px"
      }
    },
    {
      "selector": ".feature-tree-row, [role=history-station]",
      "properties": {
        "width": "100%",
        "text-align": "left",
        "padding": "2px 4px",
        "border": "none",
        "background": "transparent",
        "height": "26px",
        "icon-size": "8px"
      }
    },
    {
      "selector": ".feature-tree-row[state=selected], [role=history-station][state=selected]",
      "properties": {
        "color": "var(--active)",
        "background": "#FFE3D2",
        "height": "36px"
      }
    },
    {
      "selector": "[role=history-path]",
      "properties": {
        "color": "#666666",
        "stroke-width": "1px"
      }
    },
    {
      "selector": "[role=view-cube]",
      "properties": {
        "font-size": "9px"
      }
    },
    {
      "selector": "[role=settings-dialog]",
      "properties": {
        "background": "var(--panel)",
        "padding": "10px",
        "border": "1px solid #A9ACAF",
        "border-radius": "6px",
        "gap": "6px"
      }
    },
    {
      "selector": "[role=settings-title]",
      "properties": {
        "font-size": "14px",
        "font-weight": "bold"
      }
    },
    {
      "selector": "[role=settings-scope], [role=settings-heading]",
      "properties": {
        "font-weight": "bold",
        "font-size": "11px"
      }
    },
    {
      "selector": "[role=settings-category]",
      "properties": {
        "height": "24px",
        "padding": "3px 6px",
        "border-radius": "3px"
      }
    },
    {
      "selector": "[role=settings-category][state=selected], [role=settings-action].primary",
      "properties": {
        "background": "var(--active)",
        "color": "#191919"
      }
    },
    {
      "selector": "[role=settings-description]",
      "properties": {
        "font-size": "10px"
      }
    },
    {
      "selector": "[role=settings-diagnostic][state=invalid]",
      "properties": {
        "color": "var(--error)"
      }
    }
  ]
}
